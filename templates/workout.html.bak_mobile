<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>تسجيل تمرين - MyGym</title>
    <link rel="stylesheet" href="/static/style.css?v=3">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        .rest-timer-banner {
            display: none;
            background: #1e1b4b;
            color: #fff;
            padding: 10px 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            align-items: center;
            justify-content: space-between;
        }
        .rest-timer-banner strong { font-size: 1.2rem; color: #38bdf8; }
        .effort-selector { display: flex; gap: 4px; justify-content: center; }
        .effort-btn {
            border: 1px solid #e5e7eb; background: #fff; border-radius: 6px;
            padding: 4px 8px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s;
        }
        .effort-btn.active-easy { background: #dcfce7; border-color: #22c55e; }
        .effort-btn.active-mid { background: #fef9c3; border-color: #eab308; }
        .effort-btn.active-hard { background: #fee2e2; border-color: #ef4444; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <button class="btn-back" onclick="router ? router.navigate('home') : window.location.href='/'">← عودة</button>
            <h1 id="session-title"><i data-lucide="dumbbell" class="ui-icon"></i> جلسة جديدة</h1>
            <span id="session-timer" class="timer">00:00</span>
        </header>

        <main>
            <!-- شريط عداد الراحة بين المجموعات -->
            <div id="rest-timer-banner" class="rest-timer-banner">
                <span>⏱️ وقت الراحة: <strong id="rest-time-display">01:30</strong></span>
                <div>
                    <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" onclick="addRestTime(30)">+30ث</button>
                    <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem; color: #ef4444;" onclick="stopRestTimer()">إلغاء</button>
                </div>
            </div>

            <!-- قسم اختيار التمرين وجدول الجلسات الديناميكي -->
            <section class="card">
                <!-- قسم التمرين الحر -->
                <div id="free-section">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label>التمرين الحالي</label>
                    </div>
                    <select id="exercise-select" onchange="handleExerciseChange()">
                        <option value="">اختر تمرين للبدء...</option>
                    </select>
                </div>

                <!-- قسم تنفيذ الخطة -->
                <section id="planned-section" style="display: none;">
                    <div class="plan-sticky-bar">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <div id="plan-current-exercise-name" class="plan-current-exercise-name" style="font-weight: bold; font-size: 1.1rem;"></div>
                            <button id="swap-alt-btn" class="btn-secondary" style="display: none; padding: 4px 8px; font-size: 0.8rem;" onclick="swapCurrentPlanExerciseWithAlt()">🔄 تبديل للبديل</button>
                        </div>
                        <div id="plan-chips-row" class="plan-chips-row"></div>
                    </div>

                    <!-- شريط الاقتراحات -->
                    <div id="suggestion-box" class="text-muted" style="display: none; font-size: 0.85rem; margin-top: 10px; padding: 8px; background: rgba(0,0,0,0.03); border-radius: 6px;">
                        💡 <span id="suggestion-text"></span>
                    </div>

                    <div style="margin-top: 16px; display: flex; gap: 12px; flex-wrap: wrap;">
                        <button class="plan-extra-exercise-btn btn-secondary" onclick="toggleExtraExercise()">➕ تمرين إضافي (خارج الخطة)</button>
                        <button class="btn-secondary" style="color: #dc2626;" onclick="cancelPlannedSession()">🔙 إلغاء الخطة</button>
                    </div>
                </section>

                <!-- قسم إضافة تمرين حر أثناء تنفيذ خطة -->
                <section id="extra-exercise-section" style="display: none; margin-top: 12px;">
                    <label>اختر تمرين إضافي</label>
                    <select id="extra-exercise-select" onchange="handleExtraExerciseChange()">
                        <option value="">اختر تمرين...</option>
                    </select>
                </section>

                <!-- جدول الجلسات الديناميكي -->
                <div id="dynamic-sets-section" style="display: none; margin-top: 20px;">
                    <div class="sets-table-wrapper">
                        <table class="sets-table" dir="rtl">
                            <thead>
                                <tr>
                                    <th>الجلسة</th>
                                    <th>الوزن (كجم)</th>
                                    <th>العدات</th>
                                    <th style="width: 35%;">مستوى الإجهاد</th>
                                    <th>إجراء</th>
                                </tr>
                            </thead>
                            <tbody id="dynamic-sets-body">
                                <!-- الأسطر ستتولد هنا تلقائياً -->
                            </tbody>
                        </table>
                    </div>

                    <div class="table-actions-row" style="margin-top: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <button class="btn-secondary" onclick="addNewSetRow()">➕ إضافة جلسة جديدة</button>
                        <button class="btn-primary" id="lock-exercise-btn" style="background: #059669;" onclick="saveWholeExercise(this)">🔒 حفظ وقفل الجهاز</button>
                    </div>
                </div>
            </section>

            <!-- سجل المجموعات المحفوظة خلال اليوم -->
            <section class="card">
                <h2>المجموعات المسجلة اليوم</h2>
                <div id="sets-list">
                    <p class="text-muted">لا توجد مجموعات محفوظة في هذه الجلسة بعد</p>
                </div>
                <div class="volume-bar">
                    <span>الحجم الكلي:</span>
                    <strong id="total-volume">0 كجم</strong>
                </div>
            </section>

            <!-- إنهاء الحصة -->
            <section class="card" style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; align-items: center;">
                <button class="btn-primary" style="background: #10b981; padding: 14px; font-weight: bold; font-size: 1.1rem;" onclick="finishWorkout(this)">🔚 إنهاء وحفظ التمرين</button>
                <button class="btn-danger" style="background: #dc2626; color: white; padding: 14px; font-size: 0.9rem; opacity: 0.9;" onclick="abandonActiveSession(this)">🗑️ حذف</button>
            </section>
        </main>
    </div>

    <div id="snackbar" class="snackbar"></div>

    <script src="/static/app.js?v=5"></script>
    <script src="/static/vendor/lucide.min.js"></script>
    <script>
        if (window.lucide) lucide.createIcons();

        let activePlan = null;
        let activePlanExercises = [];
        let currentPlanIndex = 0;
        let currentExerciseId = null;
        let isUsingAltExercise = false;
        let timerSeconds = 0;

        let restInterval = null;
        let restSecondsLeft = 0;

        const urlParams = new URLSearchParams(window.location.search);
        const planIdFromUrl = urlParams.get('plan_id');

        document.addEventListener('DOMContentLoaded', async () => {
            startTimer();
            await loadExercisesList();

            if (planIdFromUrl) {
                await initPlannedWorkout(planIdFromUrl);
            }
            await loadTodaySets();
        });

        // =====================================================
        // Helpers — API
        // =====================================================
        function buildHeaders(includeContentType = false) {
            const headers = includeContentType ? { 'Content-Type': 'application/json' } : {};
            const profileId = localStorage.getItem('mygym_profile_id');
            if (profileId) headers['X-Profile-Id'] = profileId;
            return headers;
        }

        async function fetchActiveSession() {
            const res = await fetch('/api/workouts/active', { headers: buildHeaders() });
            if (!res.ok) return null;
            return await res.json();
        }

        // =====================================================
        // Timer
        // =====================================================
        function startTimer() {
            setInterval(() => {
                timerSeconds++;
                const m = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
                const s = String(timerSeconds % 60).padStart(2, '0');
                const timerElem = document.getElementById('session-timer');
                if (timerElem) timerElem.textContent = `${m}:${s}`;
            }, 1000);
        }

        // =====================================================
        // Rest timer
        // =====================================================
        function startRestTimer(seconds = 90) {
            clearInterval(restInterval);
            restSecondsLeft = seconds;
            const banner = document.getElementById('rest-timer-banner');
            if (!banner) return;
            banner.style.display = 'flex';
            updateRestDisplay();

            restInterval = setInterval(() => {
                restSecondsLeft--;
                if (restSecondsLeft <= 0) {
                    clearInterval(restInterval);
                    banner.style.display = 'none';
                    if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
                } else {
                    updateRestDisplay();
                }
            }, 1000);
        }

        function updateRestDisplay() {
            const m = String(Math.floor(restSecondsLeft / 60)).padStart(2, '0');
            const s = String(restSecondsLeft % 60).padStart(2, '0');
            const el = document.getElementById('rest-time-display');
            if (el) el.textContent = `${m}:${s}`;
        }

        function addRestTime(sec) {
            restSecondsLeft += sec;
            updateRestDisplay();
        }

        function stopRestTimer() {
            clearInterval(restInterval);
            const banner = document.getElementById('rest-timer-banner');
            if (banner) banner.style.display = 'none';
        }

        // =====================================================
        // Exercises list
        // =====================================================
        async function loadExercisesList() {
            try {
                const res = await fetch('/api/exercises');
                if (!res.ok) return;
                const data = await res.json();

                const sel = document.getElementById('exercise-select');
                const extraSel = document.getElementById('extra-exercise-select');

                sel.innerHTML = '<option value="">اختر تمرين للبدء...</option>';
                extraSel.innerHTML = '<option value="">اختر تمرين...</option>';

                data.forEach(e => {
                    const optText = e.equipment_tag ? `${e.name} (${e.equipment_tag})` : e.name;
                    sel.appendChild(new Option(optText, e.id));
                    extraSel.appendChild(new Option(optText, e.id));
                });
            } catch(e) { console.error("خطأ في تحميل التمارين", e); }
        }

        async function promptNewExercise() {
            const name = prompt("أدخل اسم التمرين أو الجهاز الجديد:");
            if (!name) return;
            const tag = prompt("تمييز الجهاز/الماركة (اختياري - مثلاً: Hammer, Cable):");

            try {
                const res = await fetch('/api/exercises', {
                    method: 'POST',
                    headers: buildHeaders(true),
                    body: JSON.stringify({ name: name.trim(), equipment_tag: tag ? tag.trim() : null })
                });

                if (res.ok) {
                    alert("✅ تم إضافة التمرين الجديد بنجاح");
                    await loadExercisesList();
                }
            } catch(e) { alert("تعذر إضافة التمرين"); }
        }

        // =====================================================
        // Planned workout
        // =====================================================
        async function initPlannedWorkout(planId) {
            try {
                const res = await fetch(`/api/planner/plans/${planId}`, { headers: buildHeaders() });
                if (!res.ok) return;

                activePlan = await res.json();
                activePlanExercises = activePlan.exercises || [];

                if (activePlanExercises.length > 0) {
                    document.getElementById('free-section').style.display = 'none';
                    document.getElementById('planned-section').style.display = 'block';

                    const titleElem = document.getElementById('session-title');
                    if (titleElem) {
                        titleElem.innerHTML = `<i data-lucide="dumbbell" class="ui-icon"></i> ${activePlan.name}`;
                        if (window.lucide) lucide.createIcons();
                    }

                    renderPlanChips();
                    selectPlanExercise(0);
                }
            } catch(e) { console.error(e); }
        }

        function renderPlanChips() {
            const container = document.getElementById('plan-chips-row');
            if (!container) return;
            container.innerHTML = '';

            activePlanExercises.forEach((item, index) => {
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = `plan-chip ${index === currentPlanIndex ? 'active' : ''} ${item.is_completed ? 'completed' : ''}`;

                const name = item.active_alt ? (item.alternative_exercise_name || item.exercise_name) : item.exercise_name;
                chip.textContent = `${index + 1}. ${name}`;
                chip.onclick = () => selectPlanExercise(index);
                container.appendChild(chip);
            });
        }

        async function selectPlanExercise(index) {
            currentPlanIndex = index;
            const item = activePlanExercises[index];
            isUsingAltExercise = !!item.active_alt;

            currentExerciseId = isUsingAltExercise ? item.alternative_exercise_id : item.exercise_id;
            const currentName = isUsingAltExercise ? item.alternative_exercise_name : item.exercise_name;

            document.getElementById('plan-current-exercise-name').textContent = currentName;

            const swapBtn = document.getElementById('swap-alt-btn');
            if (item.alternative_exercise_id) {
                swapBtn.style.display = 'inline-block';
                swapBtn.textContent = isUsingAltExercise ? '↩️ عودة للأساسي' : '🔄 تبديل للبديل';
            } else {
                swapBtn.style.display = 'none';
            }

            renderPlanChips();
            await showSuggestions(item);
            setupDynamicSetsTable(item.target_sets || 3);
        }

        function swapCurrentPlanExerciseWithAlt() {
            const item = activePlanExercises[currentPlanIndex];
            item.active_alt = !item.active_alt;
            selectPlanExercise(currentPlanIndex);
        }

        async function showSuggestions(planItem) {
            const box = document.getElementById('suggestion-box');
            const txt = document.getElementById('suggestion-text');
            box.style.display = 'block';

            let hint = `Target: ${planItem.target_sets || 3} مجموعات`;
            if (planItem.target_reps) hint += ` × ${planItem.target_reps} عدات`;

            if (planItem.target_weight_mode === 'FIXED' && planItem.fixed_weight) {
                hint += ` | الوزن الموصى به: ${planItem.fixed_weight} كجم`;
            } else {
                try {
                    const res = await fetch(`/api/planner/suggestions/${currentExerciseId}`, { headers: buildHeaders() });
                    if (res.ok) {
                        const sug = await res.json();
                        if (sug && sug.suggested_weight) hint += ` | اقتراح بناءً على آخر أداء: ${sug.suggested_weight} كجم`;
                    }
                } catch(e){}
            }
            txt.textContent = hint;
        }

        // =====================================================
        // Dynamic sets table
        // =====================================================
        function setupDynamicSetsTable(setsCount) {
            const section = document.getElementById('dynamic-sets-section');
            const tbody = document.getElementById('dynamic-sets-body');
            tbody.innerHTML = '';
            section.style.display = 'block';

            for (let i = 1; i <= setsCount; i++) {
                addNewSetRow(i);
            }
        }

        function addNewSetRow(setNum = null) {
            const tbody = document.getElementById('dynamic-sets-body');
            const num = setNum || (tbody.children.length + 1);

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${num}</strong></td>
                <td><input type="number" step="0.5" class="set-weight" placeholder="0"></td>
                <td><input type="number" class="set-reps" placeholder="0"></td>
                <td>
                    <div class="effort-selector">
                        <button type="button" class="effort-btn" onclick="setEffort(this, 'EASY')">🟢</button>
                        <button type="button" class="effort-btn active-mid" onclick="setEffort(this, 'MID')">🟡</button>
                        <button type="button" class="effort-btn" onclick="setEffort(this, 'HARD')">🔴</button>
                        <input type="hidden" class="set-effort-val" value="MID">
                    </div>
                </td>
                <td><button type="button" class="btn-danger btn-small" onclick="this.closest('tr').remove()">✕</button></td>
            `;
            tbody.appendChild(tr);
        }

        function setEffort(btn, level) {
            const parent = btn.closest('.effort-selector');
            parent.querySelectorAll('.effort-btn').forEach(b => b.className = 'effort-btn');

            if (level === 'EASY') btn.classList.add('active-easy');
            else if (level === 'MID') btn.classList.add('active-mid');
            else if (level === 'HARD') btn.classList.add('active-hard');

            parent.querySelector('.set-effort-val').value = level;
        }

        function handleExerciseChange() {
            const sel = document.getElementById('exercise-select');
            currentExerciseId = sel.value;
            if (currentExerciseId) {
                document.getElementById('suggestion-box').style.display = 'none';
                setupDynamicSetsTable(3);
            }
        }

        function toggleExtraExercise() {
            const sec = document.getElementById('extra-exercise-section');
            sec.style.display = sec.style.display === 'none' ? 'block' : 'none';
        }

        function handleExtraExerciseChange() {
            const sel = document.getElementById('extra-exercise-select');
            currentExerciseId = sel.value;
            if (currentExerciseId) {
                document.getElementById('suggestion-box').style.display = 'none';
                setupDynamicSetsTable(3);
            }
        }

        // =====================================================
        // SAVE — يستخدم API الصحيح
        // =====================================================
        async function saveWholeExercise(btn) {
            if (!currentExerciseId) { alert('اختر تمريناً أولاً'); return; }

            const rows = document.querySelectorAll('#dynamic-sets-body tr');
            const setsData = [];

            rows.forEach((row, idx) => {
                const weight = parseFloat(row.querySelector('.set-weight').value) || 0;
                const reps = parseInt(row.querySelector('.set-reps').value) || 0;
                const effort = row.querySelector('.set-effort-val').value || 'MID';

                let rpeVal = 8;
                if (effort === 'EASY') rpeVal = 6.5;
                if (effort === 'HARD') rpeVal = 10;

                if (reps > 0) {
                    setsData.push({ exercise_id: currentExerciseId, set_order: idx + 1, weight, reps, rpe: rpeVal });
                }
            });

            if (setsData.length === 0) { alert('أدخل العدات أولاً'); return; }

            btn.disabled = true;
            try {
                const headers = buildHeaders(true);

                // 1) احصل على الجلسة النشطة
                const activeData = await fetchActiveSession();
                if (!activeData || !activeData.session) {
                    alert('❌ لا توجد جلسة نشطة. ابدأ تمريناً جديداً من الصفحة الرئيسية.');
                    return;
                }
                const sessionId = activeData.session.id;

                // 2) أرسل كل مجموعة للمسار الصحيح
                for (const setPayload of setsData) {
                    const setRes = await fetch(`/api/workouts/${sessionId}/sets`, {
                        method: 'POST',
                        headers,
                        body: JSON.stringify(setPayload),
                    });
                    if (!setRes.ok) {
                        const errText = await setRes.text();
                        console.error('Set save failed:', errText);
                        alert('❌ تعذر حفظ بعض المجموعات');
                        return;
                    }
                }

                if (activePlanExercises[currentPlanIndex]) {
                    activePlanExercises[currentPlanIndex].is_completed = true;
                    renderPlanChips();
                }

                alert('✅ تم حفظ التمرين');
                document.getElementById('dynamic-sets-section').style.display = 'none';
                await loadTodaySets();
                startRestTimer(90);

            } catch(e) {
                console.error(e);
                alert('حدث خطأ أثناء الحفظ');
            } finally {
                btn.disabled = false;
            }
        }

        // =====================================================
        // LOAD — يعرض مجموعات الجلسة النشطة
        // =====================================================
        async function loadTodaySets() {
            try {
                const data = await fetchActiveSession();
                const sets = (data && data.sets) ? data.sets : [];

                const container = document.getElementById('sets-list');
                let totalVol = 0;

                if (!sets || sets.length === 0) {
                    container.innerHTML = '<p class="text-muted">لا توجد مجموعات محفوظة في هذه الجلسة بعد</p>';
                    document.getElementById('total-volume').textContent = '0 كجم';
                    return;
                }

                container.innerHTML = '';
                sets.forEach(s => {
                    totalVol += Number(s.weight || 0) * Number(s.reps || 0);
                    const item = document.createElement('div');
                    item.className = 'set-item';
                    item.style.cssText = 'padding: 8px 0; border-bottom: 1px solid #f3f4f6; display: flex; justify-content: space-between; font-size: 0.9rem;';
                    item.innerHTML = `
                        <span><strong>${s.exercise_name || 'تمرين'}</strong> (جلسة ${s.set_order ?? '?'})</span>
                        <span>${s.weight} كجم × ${s.reps}</span>
                    `;
                    container.appendChild(item);
                });

                document.getElementById('total-volume').textContent = `${totalVol.toLocaleString()} كجم`;
            } catch(e) { console.error(e); }
        }

        function cancelPlannedSession() {
            if (confirm('إلغاء الخطة للتحول للتمرين الحر؟')) {
                activePlan = null;
                activePlanExercises = [];
                document.getElementById('planned-section').style.display = 'none';
                document.getElementById('free-section').style.display = 'block';
                document.getElementById('dynamic-sets-section').style.display = 'none';
                document.getElementById('suggestion-box').style.display = 'none';
            }
        }

        // =====================================================
        // FINISH — POST /api/workouts/{session_id}/finish
        // =====================================================
        async function finishWorkout(btn) {
            if (!confirm('هل أنت متأكد من إنهاء التمرين؟')) return;
            btn.disabled = true;
            try {
                const headers = buildHeaders(true);
                const activeData = await fetchActiveSession();
                if (!activeData || !activeData.session) {
                    window.location.href = '/';
                    return;
                }
                const res = await fetch(`/api/workouts/${activeData.session.id}/finish`, {
                    method: 'POST',
                    headers,
                });
                if (!res.ok) { alert('❌ تعذر إنهاء التمرين'); return; }
                alert('✅ تم إنهاء التمرين');
                window.location.href = '/';
            } catch(e) {
                console.error(e);
                alert('حدث خطأ');
            } finally {
                btn.disabled = false;
            }
        }

        // =====================================================
        // ABANDON — POST /api/workouts/{session_id}/abandon
        // =====================================================
        async function abandonActiveSession(btn) {
            if (!confirm('حذف جلسة اليوم؟')) return;
            btn.disabled = true;
            try {
                const headers = buildHeaders(true);
                const activeData = await fetchActiveSession();
                if (!activeData || !activeData.session) {
                    window.location.href = '/';
                    return;
                }
                const res = await fetch(`/api/workouts/${activeData.session.id}/abandon`, {
                    method: 'POST',
                    headers,
                });
                if (!res.ok) { alert('❌ تعذر الحذف'); return; }
                window.location.href = '/';
            } catch(e) {
                console.error(e);
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>