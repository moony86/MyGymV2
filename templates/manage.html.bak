<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>إدارة التمارين والأجهزة - MyGym</title>
    <link rel="stylesheet" href="/static/style.css?v=2">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <header>
            <button class="btn-back" onclick="router ? router.navigate('home') : window.location.href='/'">← الصفحة الرئيسية</button>
            <h1>⚙️ الإعدادات وإدارة التمارين</h1>
        </header>

        <main>
            <!-- قسم إضافة تمرين / جهاز جديد -->
            <section class="card">
                <h2>➕ إضافة تمرين / جهاز جديد</h2>
                <form id="add-exercise-form" onsubmit="handleCreateExercise(event)">
                    <div style="margin-bottom: 12px;">
                        <label>اسم التمرين</label>
                        <input type="text" id="new-ex-name" class="input-control" placeholder="مثال: سحب ظهر سفلي" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; margin-top: 4px;">
                    </div>
                    <div style="margin-bottom: 16px;">
                        <label>علامة الجهاز / الماركة (اختياري)</label>
                        <input type="text" id="new-ex-tag" class="input-control" placeholder="مثال: Hammer Strength, Cable, B-3" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; margin-top: 4px;">
                    </div>
                    <button type="submit" class="btn-primary" style="width: 100%; background: #2563eb; padding: 12px; font-weight: bold;">حفظ التمرين الجديد</button>
                </form>
            </section>

            <!-- قائمة التمارين الحالية وإدارتها -->
            <section class="card">
                <h2>📋 قائمة التمارين المسجلة</h2>
                <div id="exercises-list-wrapper" style="margin-top: 10px;">
                    <p class="text-muted">جاري تحميل التمارين...</p>
                </div>
            </section>
        </main>
    </div>

    <script src="/static/app.js?v=4"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            loadAllExercises();
        });

        async function loadAllExercises() {
            const container = document.getElementById('exercises-list-wrapper');
            try {
                const res = await fetch('/api/exercises');
                if (!res.ok) throw new Error();
                const exercises = await res.json();

                if (!exercises || exercises.length === 0) {
                    container.innerHTML = '<p class="text-muted">لا توجد تمارين مسجلة حتى الآن.</p>';
                    return;
                }

                container.innerHTML = '';
                exercises.forEach(ex => {
                    const item = document.createElement('div');
                    item.style.cssText = 'padding: 12px 0; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;';
                    item.innerHTML = `
                        <div>
                            <strong>${ex.name}</strong>
                            ${ex.equipment_tag ? `<span style="font-size: 0.8rem; background: #e0f2fe; color: #0369a1; padding: 2px 6px; border-radius: 4px; margin-right: 6px;">${ex.equipment_tag}</span>` : ''}
                        </div>
                        <button class="btn-secondary" style="font-size: 0.8rem; padding: 4px 8px;" onclick="editExercise('${ex.id}', '${ex.name}', '${ex.equipment_tag || ''}')">✏️ تعديل</button>
                    `;
                    container.appendChild(item);
                });
            } catch(e) {
                container.innerHTML = '<p class="text-muted" style="color: red;">تعذر تحميل التمارين.</p>';
            }
        }

        async function handleCreateExercise(e) {
            e.preventDefault();
            const nameInput = document.getElementById('new-ex-name');
            const tagInput = document.getElementById('new-ex-tag');

            const payload = {
                name: nameInput.value.trim(),
                equipment_tag: tagInput.value.trim() || null
            };

            try {
                const headers = { 'Content-Type': 'application/json' };
                if (localStorage.getItem('mygym_profile_id')) headers['X-Profile-Id'] = localStorage.getItem('mygym_profile_id');

                const res = await fetch('/api/exercises', {
                    method: 'POST',
                    headers,
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    alert('✅ تم إضافة التمرين بنجاح');
                    nameInput.value = '';
                    tagInput.value = '';
                    await loadAllExercises();
                } else {
                    alert('حدث خطأ أثناء الإضافة');
                }
            } catch(err) {
                alert('تعذر الاتصال بالسيرفر');
            }
        }

        async function editExercise(id, oldName, oldTag) {
            const newName = prompt("تعديل اسم التمرين:", oldName);
            if (newName === null) return;
            const newTag = prompt("تعديل علامة الجهاز / الماركة:", oldTag);

            try {
                const headers = { 'Content-Type': 'application/json' };
                if (localStorage.getItem('mygym_profile_id')) headers['X-Profile-Id'] = localStorage.getItem('mygym_profile_id');

                const res = await fetch(`/api/exercises/${id}`, {
                    method: 'PUT',
                    headers,
                    body: JSON.stringify({ name: newName.trim(), equipment_tag: newTag ? newTag.trim() : null })
                });

                if (res.ok) {
                    alert('✅ تم تحديث التمرين');
                    await loadAllExercises();
                } else {
                    alert('تعذر التحديث');
                }
            } catch(e) { alert('حدث خطأ في الاتصال'); }
        }
    </script>
</body>
</html>
